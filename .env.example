# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # SÓ servidor. Nunca com NEXT_PUBLIC_.

# Claude (moderação + rascunho das histórias)
ANTHROPIC_API_KEY=
# MODERATION_MODEL=claude-opus-5-5  # padrão; troque por claude-haiku-5-5 se quiser mais barato/rápido
# STORY_MODEL=claude-opus-5-5

# Segredos (gere com: openssl rand -base64 48)
SESSION_SECRET=                     # assina o cookie de sessão
TOKEN_SECRET=                       # gera os links das tags NFC (Vercel E scripts, mesmo valor). Trocar = invalida TODAS as tags!
ADMIN_PIN=                          # PIN da Torre de Controle dos gestores (mín. 4 dígitos)

# URL pública (é o que vai gravado nas tags). Na Vercel é opcional (sem ela, usa o domínio atual).
# Defina o domínio definitivo ANTES de gravar as tags.
PUBLIC_BASE_URL=https://universo.suaempresa.com
